{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Consilium",
  "version": "2.0.0-alpha.4",
  "identifier": "io.consilium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:editor && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Consilium",
        "width": 1320,
        "height": 880,
        "minWidth": 940,
        "minHeight": 640,
        "backgroundColor": "#212121",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A local calendar and personal assistant.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  },
  "mainBinaryName": "consilium-desktop"
}
